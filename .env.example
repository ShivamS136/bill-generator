# Copy to .env (git-ignored) and fill in what you need. Every key is optional.
# Mode-specific overrides can go in .env.development / .env.production (also git-ignored).
# The GitHub Pages build gets these from the workflow and repository variables.

# Base path the app is served from (default: /). GitHub Pages: /<repo>/
VITE_BASE_PATH=
# owner/repo for the GitHub links (default: ShivamS136/bill-generator)
VITE_GITHUB_REPO=

# Driver salary receipt. Signatures accept an image URL, a data URL,
# or a path relative to public/ (e.g. signatures/user-signature.png; public/signatures/ is git-ignored).
VITE_DRIVER_SALARY_DRIVER_NAME=
VITE_DRIVER_SALARY_EMPLOYEE_NAME=
VITE_DRIVER_SALARY_VEHICLE_NUMBER=
VITE_DRIVER_SALARY_AMOUNT=
VITE_DRIVER_SALARY_USER_SIGNATURE=
VITE_DRIVER_SALARY_DRIVER_SIGNATURE=
