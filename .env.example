# Copy to .env (git-ignored) and fill in what you need. Every key is optional.
# Mode-specific overrides can go in .env.development / .env.production (also git-ignored).
# The GitHub Pages build gets these from the workflow and repository variables.

# Base path the app is served from (default: /). GitHub Pages: /<repo>/
VITE_BASE_PATH=
# owner/repo for the GitHub links (default: ShivamS136/bill-generator)
VITE_GITHUB_REPO=

# Driver salary receipt. Signatures default to the names in a handwriting font;
# change them in the app (type, draw, upload or URL).
VITE_DRIVER_SALARY_DRIVER_NAME=
VITE_DRIVER_SALARY_EMPLOYEE_NAME=
VITE_DRIVER_SALARY_LICENCE_NUMBER=
VITE_DRIVER_SALARY_VEHICLE_NUMBER=
VITE_DRIVER_SALARY_AMOUNT=

# Fuel bill. The roll serial is the faint number printed down the edge of the paper roll.
VITE_FUEL_BILL_STATION_NAME=
VITE_FUEL_BILL_STATION_ADDRESS=
VITE_FUEL_BILL_TELEPHONE=
VITE_FUEL_BILL_FCC_ID=
VITE_FUEL_BILL_VEHICLE_NUMBER=
VITE_FUEL_BILL_CUSTOMER_NAME=
VITE_FUEL_BILL_ROLL_SERIAL=

# Internet bill. Use \n for line breaks in the address, inside double quotes.
VITE_INTERNET_BILL_CUSTOMER_NAME=
VITE_INTERNET_BILL_CUSTOMER_ADDRESS=
VITE_INTERNET_BILL_ACCOUNT_NUMBER=
VITE_INTERNET_BILL_AMOUNT=
